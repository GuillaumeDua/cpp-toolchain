# Build context is the repo root; the build only needs the Dockerfile, scripts/ and test/.
# Everything below is excluded to keep the context small (does not affect layer
# caching, which keys the COPY layers on the scripts/*.sh contents).

# cache / editor
.cache
build

# secrets
*.env
*.pem
*.key

# Ignore all hidden files and directories (.git, .github, .devcontainer, .vscode, .claude, ...)
.*

# Repository tooling - pin guard, release-note renderer, promotion-record schema, smoke test.
# The smoke test reaches a built image by bind-mount rather than being COPYed.
scripts/details

# The one exception: the install and checks scripts source it, so it has to reach every stage that
# runs one of them. The standalone copies published per release carry it inlined instead.
!scripts/details/shared.sh

# Non-build content living at the repo root
docs
releases
*.md
LICENSE
CODEOWNERS
renovate.json

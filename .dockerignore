# Build context is the repo root: the build only needs the Dockerfile + scripts/.
# Everything below is excluded to keep the context small (does not affect layer caching, which keys the COPY layers on the scripts/*.sh contents).

# cache / editor
.cache
build

# secrets
*.env
*.pem
*.key

# Ignore all hidden files and directories (.git, .github, .devcontainer, .vscode, .claude, ...)
.*

# Repository tooling - pin guard, release-note renderer, promotion-record schema, image verification.
# Nothing here is COPYed by the Dockerfile:
#   the verification suite reaches a built image by bind-mount, which is also what keeps the tests out of the images they test.
scripts/details

# Non-build content living at the repo root
docs
releases
*.md
LICENSE
CODEOWNERS
renovate.json
